<Window x:Class="LicenseManagement.EndUser.Wpf.Views.ErrorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LicenseManagement.EndUser.Wpf.Views"
        mc:Ignorable="d"
        Title="Error"
        FontFamily="Segoe UI"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Width="480">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source='pack://application:,,,/LicenseManagement.EndUser.Wpf;component/AppResources.xaml' />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <StackPanel Margin='26,24,26,22'>
    <StackPanel Orientation='Horizontal'>
      <Border Width='38' Height='38' CornerRadius='10' VerticalAlignment='Top'
              Background='{StaticResource LmDangerTintBrush}'>
        <TextBlock Text='!' Foreground='{StaticResource LmDangerBrush}' FontSize='22' FontWeight='Bold'
                   HorizontalAlignment='Center' VerticalAlignment='Center' />
      </Border>
      <StackPanel Margin='13,0,0,0' VerticalAlignment='Center'>
        <TextBlock Text='Something went wrong' Style='{StaticResource LmHeading}' FontSize='17' />
        <TextBlock Text='The license operation could not be completed.' Style='{StaticResource LmCaption}' Margin='0,2,0,0' />
      </StackPanel>
    </StackPanel>

    <!-- error detail -->
    <Border Margin='0,18,0,0' CornerRadius='10' Background='#FCFDFE'
            BorderBrush='{StaticResource LmLineBrush}' BorderThickness='1' Padding='14,12'>
      <StackPanel>
        <TextBlock Text='{Binding Path=Message}' Foreground='{StaticResource LmInkBrush}'
                   FontSize='13' TextWrapping='Wrap' />
        <TextBlock Margin='0,8,0,0' Text='{Binding Path=InnerException.Message, FallbackValue={x:Null}}'
                   Style='{StaticResource LmCaption}' TextWrapping='Wrap' />
        <TextBlock Margin='0,6,0,0' Text='{Binding Path=InnerException.InnerException.Message, FallbackValue={x:Null}}'
                   Style='{StaticResource LmCaption}' TextWrapping='Wrap' />
      </StackPanel>
    </Border>

    <StackPanel Orientation='Horizontal' HorizontalAlignment='Right' Margin='0,18,0,0'>
      <Button Content='OK' IsCancel='True' IsDefault='True' Style='{StaticResource LmPrimaryButton}' MinWidth='110' />
    </StackPanel>
  </StackPanel>
</Window>
