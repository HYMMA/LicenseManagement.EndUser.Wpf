<Window x:Class="LicenseManagement.EndUser.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:views='clr-namespace:LicenseManagement.EndUser.Wpf.Views'
        DataContext='{Binding RelativeSource={RelativeSource Mode=Self}, Path=License}'
        Title="License"
        Height="620"
        Width="780"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Name='thisView'>
  <!-- The window is a thin host; all UI lives in the reusable LicenseControl so the
       embedded and standalone-window experiences stay identical. -->
  <views:LicenseControl License='{Binding}' />
</Window>
