<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Products" type="System.Configuration.NameValueSectionHandler" />
    <!-- Optional: lets the license window group the product cards (v2.3+). -->
    <section name="ProductGroups" type="System.Configuration.NameValueSectionHandler" />
  </configSections>

  <!--
    License Management settings.
    Replace each placeholder with the corresponding value from
    https://license-management.com/dashboard. NEVER commit a real Master API
    key here; ApiKey must be a CLIENT (publishable) key.
  -->
  <appSettings>
    <add key="vendorId"  value="VDR_YOUR_VENDOR_ID" />
    <add key="productId" value="PRD_YOUR_PRODUCT_ID" />
    <add key="ApiKey"    value="PUB_YOUR_CLIENT_API_KEY" />
    <add key="publicKey" value="&lt;RSAKeyValue&gt;&lt;Modulus&gt;YOUR_MODULUS_HERE&lt;/Modulus&gt;&lt;Exponent&gt;AQAB&lt;/Exponent&gt;&lt;/RSAKeyValue&gt;" />
    <add key="validDays" value="90" />
    <!-- Card layout the developer picks: Bands (default) | Lanes | Switcher -->
    <add key="licenseLayout" value="Bands" />
  </appSettings>

  <!-- Products to show as cards. Each entry's key is the product id, the value is
       the display name. -->
  <Products>
    <add key="PRD_YOUR_MONTHLY_BASIC" value="Basic (monthly)" />
    <add key="PRD_YOUR_MONTHLY_PRO"   value="Pro (monthly)" />
    <add key="PRD_YOUR_ANNUAL_BASIC"  value="Basic (annual)" />
    <add key="PRD_YOUR_ANNUAL_PRO"    value="Pro (annual)" />
  </Products>

  <!-- Optional grouping (v2.3+). Each value is "Label | Caption | #Accent | id1,id2,...".
       Remove this section to show every product in one unlabeled group. -->
  <ProductGroups>
    <add key="monthly" value="Monthly | Renews every month | #0E8F9C | PRD_YOUR_MONTHLY_BASIC,PRD_YOUR_MONTHLY_PRO" />
    <add key="annual"  value="Annual | Renews once a year | #B5751A | PRD_YOUR_ANNUAL_BASIC,PRD_YOUR_ANNUAL_PRO" />
  </ProductGroups>
</configuration>
