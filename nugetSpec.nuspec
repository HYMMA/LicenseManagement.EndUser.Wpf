<?xml version="1.0" encoding="utf-8"?>
<package>
	<metadata minClientVersion="2.5">
		<id>LicenseManagement.EndUser.Wpf</id>
		<version>2.2.1</version>
		<authors>HYMMA</authors>
		<owners>HYMMA</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<license type="expression">MIT</license>
		<description>WPF UI components for license-management.com end-user SDK. Provides ready-to-use Window and UserControl components, view models, and converters for license registration and management workflows. Bundles all required dependencies for easy deployment.</description>
		<releaseNotes>2.1.0: Bumps dependency to LicenseManagement.EndUser 3.0.1 (tamper detection fix, uninstall reads from disk). Adds unit test project for ViewModels.</releaseNotes>
		<projectUrl>https://github.com/HYMMA/LicenseManagement.EndUser.Wpf</projectUrl>
		<repository type="git" url="https://github.com/HYMMA/LicenseManagement.EndUser.Wpf.git" />
		<readme>README.md</readme>
		<tags>license licensing wpf ui components views viewmodels usercontrol hymma license-management</tags>
		<!-- net481 bundles its deps as loose files in lib\net481 (below); net8.0-windows
		     pulls them via normal package dependencies instead. -->
		<dependencies>
			<!-- net481 bundles every dependency as a loose file in lib\net481, so it has
			     no package dependencies — but the group must be declared to match the folder. -->
			<group targetFramework=".NETFramework4.8.1" />
			<group targetFramework="net8.0-windows7.0">
				<dependency id="LicenseManagement.EndUser" version="3.1.1" />
				<dependency id="System.Configuration.ConfigurationManager" version="9.0.17" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="README.md" target="" />
		<!-- net8.0-windows assembly (deps come from the dependency group above) -->
		<file src="net8\bin\Release\net8.0-windows\LicenseManagement.EndUser.Wpf.dll" target="lib\net8.0-windows7.0" />
		<file src="net8\bin\Release\net8.0-windows\LicenseManagement.EndUser.Wpf.pdb" target="lib\net8.0-windows7.0" />
		<!-- Main assemblies -->
		<file src="bin\Release\LicenseManagement.EndUser.Wpf.dll" target="lib\net481" />
		<file src="bin\Release\LicenseManagement.EndUser.Wpf.pdb" target="lib\net481" />
		<!-- Bundled dependencies from EndUser package -->
		<file src="packages\LicenseManagement.EndUser.3.1.1\lib\net481\LicenseManagement.EndUser.dll" target="lib\net481" />
		<!-- Bundled dependencies from other packages -->
		<file src="packages\Hymma.HttpClientFactory.1.0.8\lib\net45\Hymma.HttpClientFactory.dll" target="lib\net481" />
		<file src="packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll" target="lib\net481" />
		<file src="packages\DeviceId.6.9.0\lib\net40\DeviceId.dll" target="lib\net481" />
		<file src="packages\DeviceId.Windows.6.9.0\lib\net40\DeviceId.Windows.dll" target="lib\net481" />
		<file src="packages\DeviceId.Windows.Wmi.6.9.0\lib\net40\DeviceId.Windows.Wmi.dll" target="lib\net481" />
		<file src="packages\Microsoft.Bcl.AsyncInterfaces.1.1.0\lib\net461\Microsoft.Bcl.AsyncInterfaces.dll" target="lib\net481" />
		<file src="packages\System.Memory.4.5.5\lib\net461\System.Memory.dll" target="lib\net481" />
		<file src="packages\System.Buffers.4.5.1\lib\net461\System.Buffers.dll" target="lib\net481" />
		<file src="packages\System.Numerics.Vectors.4.5.0\lib\net46\System.Numerics.Vectors.dll" target="lib\net481" />
		<file src="packages\System.Runtime.CompilerServices.Unsafe.6.0.0\lib\net461\System.Runtime.CompilerServices.Unsafe.dll" target="lib\net481" />
		<file src="packages\System.Threading.Tasks.Extensions.4.5.4\lib\net461\System.Threading.Tasks.Extensions.dll" target="lib\net481" />
		<file src="packages\System.Text.Encodings.Web.4.5.1\lib\netstandard2.0\System.Text.Encodings.Web.dll" target="lib\net481" />
	</files>
</package>
