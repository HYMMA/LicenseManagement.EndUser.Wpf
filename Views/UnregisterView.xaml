<Window x:Class="LicenseManagement.EndUser.Wpf.Views.UnregisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LicenseManagement.EndUser.Wpf.Views"
        mc:Ignorable="d"
        SizeToContent='Height'
        Title="Release License"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Width="420"
        Name='thisView'>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source='pack://application:,,,/LicenseManagement.EndUser.Wpf;component/AppResources.xaml' />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <StackPanel Margin='26,24,26,22'>
    <StackPanel Orientation='Horizontal'>
      <Border Width='38' Height='38' CornerRadius='10' VerticalAlignment='Top'
              Background='{StaticResource LmDangerTintBrush}'>
        <TextBlock Text='&#x21BA;' Foreground='{StaticResource LmDangerBrush}' FontSize='20'
                   HorizontalAlignment='Center' VerticalAlignment='Center' />
      </Border>
      <StackPanel Margin='13,0,0,0' VerticalAlignment='Center'>
        <TextBlock Text='Release this license?' Style='{StaticResource LmHeading}' FontSize='17' />
        <TextBlock Style='{StaticResource LmCaption}' Margin='0,4,0,0' MaxWidth='300' HorizontalAlignment='Left'
                   Text='This unlinks the license from this computer so you can activate it on another. You can re-register here anytime.' />
      </StackPanel>
    </StackPanel>

    <StackPanel Orientation='Horizontal' HorizontalAlignment='Right' Margin='0,20,0,0'>
      <Button Content='Cancel' IsCancel='True' Style='{StaticResource LmGhostButton}' MinWidth='92' />
      <Button Content='Release the license'
              Command='{Binding Unregister}'
              CommandParameter='{x:Reference Name=thisView}'
              Style='{StaticResource LmDangerButton}'
              Margin='10,0,0,0' MinWidth='150' />
    </StackPanel>
  </StackPanel>
</Window>
